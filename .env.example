# Copy to .env and replace the placeholder secrets.

POSTGRES_USER=destekai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=destekai
POSTGRES_PORT=5432

# Password of the destekai_agent role, which can only reach the policy index.
AGENT_DB_PASSWORD=change-me-too

ORDER_API_PORT=8080
# Session tokens are signed with an Ed25519 key pair in ./secrets, not with a value here.
# Create it once with `make keys`.
# Loads the demo data on startup when the database is empty.
SEED_DATA=true
# Adds the customer picker's login, which issues a token for any customer. Demo only.
DEV_LOGIN=true

FRONTEND_PORT=3000
# Only for frontend/scripts/fetch-product-images.mjs. Free key from unsplash.com/developers.
UNSPLASH_ACCESS_KEY=
AGENT_SERVICE_PORT=8000
# gemini or ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
# Required for the gemini provider. Get one from Google AI Studio.
GEMINI_API_KEY=
# Reachable from inside the container when Ollama runs on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# gemini or local. Local needs the local-embeddings extra in the image and
# EMBEDDING_MODEL=intfloat/multilingual-e5-base.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Evaluation (evals/). The simulated customer and the judge run on their own models, which
# keeps them off the agent's daily quota. Empty means LLM_MODEL.
SIMULATOR_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.5-flash
# USD per million tokens of the agent's model, for the cost column. Leave empty if unknown.
# gemini-3.6-flash, paid tier, per aistudio.google.com/docs/pricing (checked 2026-11-06). These
# prices hold until 2026-12-31; from 2027-01-01 they are 1.50 and 7.50.
PRICE_INPUT_PER_MTOK=0.75
PRICE_OUTPUT_PER_MTOK=3.75

# Optional Langfuse export. Traces are always stored in Postgres (agent_traces); with both
# keys set they are also sent to this Langfuse host. Empty keys: nothing leaves the machine.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Messages one account may send to the assistant, to protect the model quota.
CHAT_LIMIT_PER_MINUTE=20
CHAT_LIMIT_PER_DAY=300
# Days personal data is kept: conversations, traces, and the admin audit log.
MEMORY_RETENTION_DAYS=30
TRACE_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
