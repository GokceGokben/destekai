# Copy to .env and replace the placeholder secrets.

POSTGRES_USER=destekai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=destekai
POSTGRES_PORT=5432

ORDER_API_PORT=8080
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Loads the demo data on startup when the database is empty.
SEED_DATA=true
