# Copy to .env and replace the placeholder secrets.

POSTGRES_USER=destekai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=destekai
POSTGRES_PORT=5432

# Password of the destekai_agent role, which can only reach the policy index.
AGENT_DB_PASSWORD=change-me-too

ORDER_API_PORT=8080
# At least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# Loads the demo data on startup when the database is empty.
SEED_DATA=true

AGENT_SERVICE_PORT=8000
# gemini or ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
# Required for the gemini provider. Get one from Google AI Studio.
GEMINI_API_KEY=
# Reachable from inside the container when Ollama runs on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# gemini or local. Local needs the local-embeddings extra in the image and
# EMBEDDING_MODEL=intfloat/multilingual-e5-base.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
